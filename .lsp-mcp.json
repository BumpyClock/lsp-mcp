{
  "languages": [
    "rust",
    "python",
    "javascript",
    "typescript",
    "golang",
    "java",
    "c",
    "cpp",
    "csharp"
  ],
  "tools": {
    "preset": "full",
    "enable": [
      "semanticSearch"
    ],
    "disable": [
      "listFiles",
      "readSourceCode"
    ]
  },
  "semantic_search": {
    "enabled": true,
    "embedder": {
      "provider": "fastembed"
    }
  },
  "debug": {
    "enabled": true,
    "log_level": "debug",
    "log_dir": ".lsp-mcp/logs"
  }
}