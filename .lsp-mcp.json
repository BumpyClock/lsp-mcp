{
  "languages": [
    "rust"
  ],
  "tools": {
    "preset": "full",
    "enable": [
      "semanticSearch"
    ],
    "disable": [
      "listFiles",
      "readSourceCode"
    ]
  },
  "semantic_search": {
    "enabled": true,
    "exclude": {
      "directories": [
        "**/sample_project/**"
      ]
    }
  },
  "debug": {
    "enabled": true,
    "log_level": "debug",
    "log_dir": ".lsp-mcp/logs"
  }
}
